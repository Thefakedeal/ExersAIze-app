{
  "expo": {
    "name": "ExersAIze",
    "slug": "exersaize-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/exersaize.png",
    "scheme": "exersaizemobileapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.exersaizemobileapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.exersaizemobileapp",
      "permissions": [
        "ACTIVITY_RECOGNITION",
        "BODY_SENSORS",
        "CAMERA",
        "FOREGROUND_SERVICE",
        "INTERNET",
        "RECORD_AUDIO",
        "VIBRATE",
        "WAKE_LOCK",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "react-native-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "healthSharePermission": "Allow ExersAIze to read your health and fitness data.",
          "healthUpdatePermission": "Allow ExersAIze to save your workout and fitness data."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "be8153c8-07bc-40bd-9066-27f6c13c0ac6"
      }
    }
  }
}